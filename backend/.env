# ── Database ──────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:admin123@localhost:5432/traffic_db
REDIS_URL=redis://localhost:6379

# ── LLM API Keys ──────────────────────────────────
# Get Gemini key FREE at: https://aistudio.google.com/app/apikey
# System auto-falls back to built-in template if key is invalid
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_key_here
CLAUDE_API_KEY=
OPENAI_API_KEY=

# ── Plate Recognizer ──────────────────────────────
# Your key is already working!
PLATE_RECOGNIZER_KEY=88fd4da1b5a81e5ad08b24ccc9d7f38d9dd25c03

# ── Detection Settings ────────────────────────────
YOLO_CONFIDENCE=0.15
HELMET_CONFIDENCE=0.45
MAX_RIDERS=2  # 3+ riders = triple riding violation
SPEED_LIMIT_KMH=40.0

# ── Models ────────────────────────────────────────
YOLO_MODEL=yolov8x-visdrone.pt
YOLO_FALLBACK=yolov8n.pt
HELMET_MODEL=helmet_model.pt

# ── Auth ──────────────────────────────────────────
SECRET_KEY=viatra-super-secret-jwt-key-2026
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ── Admin ─────────────────────────────────────────
ADMIN_EMAIL=admin@viatra.gov.in
ADMIN_PASSWORD=Admin@1234
ADMIN_NAME=Super Admin

# ── Vahan/Parivahan Integration ───────────────────
# Get Surepass free key at: https://surepass.io/
SUREPASS_API_KEY=your_surepass_key_here
# Get Vahan NIC key at: https://vahan.parivahan.gov.in/vahanservice
VAHAN_API_KEY=your_vahan_key_here
